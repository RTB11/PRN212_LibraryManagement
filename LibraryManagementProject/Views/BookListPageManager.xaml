<Page x:Class="LibraryManagementProject.Views.BookListPageManager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#ECF0F1">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="White" CornerRadius="5" Padding="12" Margin="0,0,0,15">
            <WrapPanel VerticalAlignment="Center">

                <TextBlock Text="Search:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="txtSearch"
                         Width="220"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Padding="5,0"
                         Margin="0,0,20,0"
                         TextChanged="txtSearch_TextChanged"/>

                <TextBlock Text="Category:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,8,0"/>

                <ComboBox x:Name="cbCategory"
                          Width="180"
                          Height="30"
                          VerticalContentAlignment="Center"
                          Margin="0,0,20,0"
                          SelectionChanged="cbCategory_SelectionChanged"/>

                <Button x:Name="btnSearch"
                        Content="Search"
                        Width="80"
                        Height="30"
                        Margin="0,0,10,0"
                        Click="btnSearch_Click"/>

                <Button x:Name="btnReset"
                        Content="Reset"
                        Width="80"
                        Height="30"
                        Click="btnReset_Click"/>

            </WrapPanel>
        </Border>

        <ListView x:Name="lvBooks"
                  Grid.Column="0"
                  Grid.Row="1"
                  SelectionChanged="lvBooks_SelectionChanged"    
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <ListView.View>
                <GridView>

                    <GridViewColumn Header="ID"
                                    Width="50"
                                    DisplayMemberBinding="{Binding BookId}"/>

                    <GridViewColumn Header="Title"
                                    Width="200"
                                    DisplayMemberBinding="{Binding Title}"/>

                    <GridViewColumn Header="ISBN"
                                    Width="120"
                                    DisplayMemberBinding="{Binding Isbn}"/>

                    <GridViewColumn Header="Author"
                                    Width="160"
                                    DisplayMemberBinding="{Binding Author.AuthorName}"/>

                    <GridViewColumn Header="Category"
                                    Width="130"
                                    DisplayMemberBinding="{Binding Category.CategoryName}"/>

                    <GridViewColumn Header="Price"
                                    Width="90"
                                    DisplayMemberBinding="{Binding Price}"/>

                    <GridViewColumn Header="Available"
                                    Width="80"
                                    DisplayMemberBinding="{Binding AvailableQuantity}"/>

                    <GridViewColumn Header="Status"
                                    Width="90"
                                    DisplayMemberBinding="{Binding StatusText}"/>

                </GridView>
            </ListView.View>

        </ListView>

        <StackPanel Grid.Column="1"
                    Grid.Row="1"
                    Margin="15,0,0,0"
                    VerticalAlignment="Top">

            <Button x:Name="btnAdd"
                    Content="Add Book"
                    Width="130"
                    Height="35"
                    Margin="0,0,0,10"
                    Click="btnAdd_Click"/>

            <Button x:Name="btnUpdate"
                    Content="Update"
                    Width="130"
                    Height="35"
                    Margin="0,0,0,10"
                    Click="btnUpdate_Click"/>

        </StackPanel>

    </Grid>
</Page>
